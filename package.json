{
  "name": "yesim",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:remote": "CF_REMOTE=1 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:d1:create": "wrangler d1 create yesim-content",
    "cf:r2:create": "wrangler r2 bucket create yesim-media",
    "cf:kv:create": "wrangler kv namespace create NEXT_INC_CACHE_KV",
    "db:seed:sql": "node scripts/gen-seed-sql.ts",
    "seed:images:render": "node scripts/gen-seed-images.ts",
    "seed:images": "node scripts/put-seed-images.ts",
    "seed:images:remote": "node scripts/put-seed-images.ts --remote",
    "db:migrate:local": "wrangler d1 migrations apply yesim-content --local",
    "admin:set": "node scripts/admin-user.ts",
    "db:reset:local": "wrangler d1 execute yesim-content --local --file scripts/reset.sql --yes && npm run db:migrate:local && npm run seed:images && npm run admin:set -- --local",
    "db:migrate": "wrangler d1 migrations apply yesim-content --remote",
    "db:console:local": "wrangler d1 execute yesim-content --local --command",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "jose": "^6.2.12",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
